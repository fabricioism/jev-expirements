{
  "name": "@jev/chat-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch src/server/index.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "start": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^18.0.1",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
